					<string name="ScriptGuid">{A4473291-F0E9-4058-9A69-4787710FFE56}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">KoreanLabels</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd000022f5</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="2049">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- The high-resolution cover and its lightweight preview both travel with the place.
local Encoding = game:GetService("EncodingService")
local Assets = game:GetService("AssetService")
local function renderPreview(frame)
    local width,height,strip = 120,48,15
    local data = Encoding:Base64Decode(buffer.fromstring(frame.Preview.Value))
    for y=0,height-1 do
        for x=0,width-1,strip do
            local tile = Instance.new("Frame")
            tile.BorderSizePixel = 0
            tile.BackgroundColor3 = Color3.new(1,1,1)
            tile.Position = UDim2.fromScale(x/width,y/height)
            tile.Size = UDim2.new(strip/width,1,1/height,1)
            tile.ZIndex = frame.ZIndex
            local keys = {}
            for i=0,strip-1 do
                local a = (y*width+x+i)*3
                keys[i+1] = ColorSequenceKeypoint.new(i/(strip-1),Color3.fromRGB(
                    buffer.readu8(data,a),buffer.readu8(data,a+1),buffer.readu8(data,a+2)))
            end
            local gradient = Instance.new("UIGradient")
            gradient.Color = ColorSequence.new(keys)
            gradient.Parent = tile
            tile.Parent = frame
        end
    end
end

return function(frame)
    local ok, bitmap = pcall(function()
        local size = Vector2.new(560,224)
        local image = Assets:CreateEditableImage({Size=size})
        if not image then return nil end
        local pixels = Encoding:Base64Decode(buffer.fromstring(frame.Pixels.Value))
        local rgba = buffer.create(size.X*size.Y*4)
        for i=0,size.X*size.Y-1 do
            local index = buffer.readu8(pixels,1024+i)
            buffer.writeu32(rgba,i*4,buffer.readu32(pixels,index*4))
        end
        image:WritePixelsBuffer(Vector2.zero,size,rgba)
        frame.ImageContent = Content.fromObject(image)
        return image
    end)
    if ok and bitmap then
        frame.Destroying:Once(function() bitmap:Destroy() end)
    else
        renderPreview(frame)
    end
end
]]></ProtectedString>
					<string name="ScriptGuid">{84A6F5D3-0F9D-43B0-B30F-1C5154883DC5}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">StoryArt</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd000022f6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="2050">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[return function(overlay)
    local page=overlay.Message
    local viewport=overlay.AbsoluteSize
    local width=math.max(160,math.min(500,viewport.X-32))
    local narrow=width<400
    local inset=if narrow then 16 else 23
    local body=if narrow then 43 else 30
    local footer=12+36+2*body+(if page.Start.Visible then 9+42 else 0)+12
    local hero=math.max(25,math.min((width-16)/2.5,viewport.Y-footer-24))
    page.Size=UDim2.fromOffset(width,hero+footer+8)
    page.Seascape.Size=UDim2.new(1,-16,0,hero)
    local function place(item,top,height)
        item.Position=UDim2.fromOffset(inset,top)
        item.Size=UDim2.new(1,-2*inset,0,height)
    end
    local top=hero+14
    place(page.Title,top,36)
    page.Title.TextSize=if narrow then 26 else 30
    page.Story.TextSize=if narrow then 16 else 18
    page.Request.TextSize=page.Story.TextSize
    place(page.Story,top+38,body)
    place(page.Request,top+38+body,body)
    local buttonTop=top+44+2*body
    place(page.Start,buttonTop,42)
    local exit=page:FindFirstChild("Exit")
    if exit and exit.Visible then
        local half=math.floor((width-2*inset-8)/2)
        page.Start.Size=UDim2.fromOffset(half,42)
        exit.Position=UDim2.fromOffset(inset+half+8,buttonTop)
        exit.Size=UDim2.new(1,-(2*inset+half+8),0,42)
    end
end

]]></ProtectedString>
					<string name="ScriptGuid">{0B49CEA9-AA9D-4C14-84D7-C27A75D2A071}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">StoryLayout</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd000022f7</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="2051">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Gui = game:GetService("GuiService")
local Input = game:GetService("UserInputService")
local Prompts = game:GetService("ProximityPromptService")
local Actions = game:GetService("ContextActionService")
local StarterGui = game:GetService("StarterGui")
local V = Vector3.new

local function curve(a,b,c,d,t)
    local s=1-t
    return a*(s*s*s)+b*(3*s*s*t)+c*(3*s*t*t)+d*(t*t*t)
end

local layout=require(script.Parent.StoryLayout)

return function(hud,boat)
    local user=Players.LocalPlayer
    local overlay, log=hud.Arrival,hud.Log
    local button=overlay.Message.Start
    local promptsBefore=Prompts.Enabled
    local selectionBefore=Gui.SelectedObject
    local coreBefore={}
    for _,kind in {Enum.CoreGuiType.Chat,Enum.CoreGuiType.PlayerList} do
        pcall(function()
            coreBefore[kind]=StarterGui:GetCoreGuiEnabled(kind)
            StarterGui:SetCoreGuiEnabled(kind,false)
        end)
    end
    overlay.Visible=false
    log.Visible=false
    Prompts.Enabled=false
    Actions:BindActionAtPriority("KeeperOpeningMovement",function()
        return Enum.ContextActionResult.Sink
    end,false,Enum.ContextActionPriority.High.Value,unpack(Enum.PlayerActions:GetEnumItems()))
    local active=true
    local elapsed=0
    local stepName="KeeperOpeningCamera"
    local camera=workspace.CurrentCamera
    local originalFov=if camera then camera.FieldOfView else 70
    local origin=boat.Position
    local menuConnections={}
    local function focusStart()
        if overlay.Visible and Input.PreferredInput==Enum.PreferredInput.Gamepad then Gui.SelectedObject=button end
    end
    local function beginSearch()
        if not active or not overlay.Visible then return end
        active=false
        Run:UnbindFromRenderStep(stepName)
        Actions:UnbindAction("KeeperOpeningMovement")
        Prompts.Enabled=promptsBefore
        for kind,value in coreBefore do pcall(function() StarterGui:SetCoreGuiEnabled(kind,value) end) end
        for _,c in menuConnections do c:Disconnect() end
        if Gui.SelectedObject==button then Gui.SelectedObject=selectionBefore end
        local cam=workspace.CurrentCamera
        local hum=user.Character and user.Character:FindFirstChildOfClass("Humanoid")
        if cam then
            if hum then cam.CameraSubject=hum end
            cam.FieldOfView=originalFov
            cam.CameraType=Enum.CameraType.Custom
        end
        overlay.Visible=false
        log.Visible=true
        overlay:Destroy()
    end
    layout(overlay)
    table.insert(menuConnections,overlay:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() layout(overlay) end))
    table.insert(menuConnections,Input:GetPropertyChangedSignal("PreferredInput"):Connect(focusStart))
    table.insert(menuConnections,button.Activated:Connect(beginSearch))
    table.insert(menuConnections,Input.InputBegan:Connect(function(input,processed)
        if not processed and input.KeyCode==Enum.KeyCode.Return then beginSearch() end
    end))
    local wasReduced=Gui.ReducedMotionEnabled
    Run:BindToRenderStep(stepName,Enum.RenderPriority.Camera.Value+2,function(dt)
        local cam=workspace.CurrentCamera
        if not cam then return end
        cam.CameraType=Enum.CameraType.Scriptable
        local character=user.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")
        local hum=character and character:FindFirstChildOfClass("Humanoid")
        if hum then hum:Move(Vector3.zero); hum.Jump=false end
        if root and game:IsLoaded() then elapsed+=dt end
        local keeper=if root then root.Position else workspace.HarbourArrival.Position+V(0,3,0)
        local travel=math.clamp((elapsed-2.2)/5.8,0,1)
        if wasReduced then travel=if elapsed<2.2 then 0 else 1 end
        local t=travel*travel*(3-2*travel)
        local eye=curve(origin+V(-17,6.6,-18),origin+V(-53,29,58),keeper+V(-43,22,-17),keeper+V(4,5.3,12),t)
        local aim=curve(origin+V(0,2.5,0),origin+V(13,7,61),keeper+V(-3,5,-33),keeper+V(-.9,1.1,-2),t)
        cam.FieldOfView=if travel==1 then originalFov else 55+(originalFov-55)*t
        cam.CFrame=CFrame.lookAt(eye,aim)
        cam.Focus=CFrame.new(aim)
        if not overlay.Visible and elapsed>=(if wasReduced then 2.75 else 8.55) then
            overlay.Visible=true
            focusStart()
        end
    end)
    task.defer(require(hud.StoryArt),overlay.Message.Seascape)
    return function() return active end
end
]]></ProtectedString>
					<string name="ScriptGuid">{68BFC35B-7B1B-470D-BD6C-24A03129A667}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Opening</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd000022f8</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="2052">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Gui=game:GetService("GuiService")
local Input=game:GetService("UserInputService")
local Actions=game:GetService("ContextActionService")
local Prompts=game:GetService("ProximityPromptService")
local Storage=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Players=game:GetService("Players")
local layout=require(script.Parent.StoryLayout)

return function(hud,island,inOpening)
    local overlay,log=hud.Homecoming,hud.Log
    local page=overlay.Message
    local finished=false
    local pending=false
    local previousSelection
    local previousPrompts=true
    local function focus()
        if overlay.Visible and not finished and Input.PreferredInput==Enum.PreferredInput.Gamepad then
            Gui.SelectedObject=page.Start
        end
    end
    local function refresh()
        if inOpening() or finished then return end
        local show=island:GetAttribute("Phase")=="Home"
        if show==overlay.Visible then return end
        pending=false
        overlay.Visible=show
        log.Visible=not show
        if show then
            previousSelection=Gui.SelectedObject
            previousPrompts=Prompts.Enabled
            Prompts.Enabled=false
            Actions:BindActionAtPriority("KeeperResultMovement",function()
                return Enum.ContextActionResult.Sink
            end,false,Enum.ContextActionPriority.High.Value,unpack(Enum.PlayerActions:GetEnumItems()))
            layout(overlay)
            focus()
        else
            Prompts.Enabled=previousPrompts
            Actions:UnbindAction("KeeperResultMovement")
            if Gui.SelectedObject==page.Start or Gui.SelectedObject==page.Exit then Gui.SelectedObject=previousSelection end
        end
    end
    page.Start.Activated:Connect(function()
        if not overlay.Visible or finished or pending then return end
        pending=true
        Storage.PlayAgain:FireServer()
    end)
    page.Exit.Activated:Connect(function()
        if not overlay.Visible or finished or pending then return end
        finished=true
        Gui.SelectedObject=nil
        page.Title.Text="오늘 밤도 고마워요"
        page.Story.Text="등대지기의 하루가 끝났어요."
        page.Request.Text=if Run:IsStudio() then "Studio 테스트를 마치려면 Shift + F5를 누르세요."
            else "왼쪽 위 Roblox 메뉴에서 ‘나가기’를 선택하세요."
        page.Start.Visible=false
        page.Exit.Visible=false
        layout(overlay)
        if Run:IsStudio() then
            if #Players:GetPlayers()==1 then
                Storage.FinishStudioPlay:FireServer()
            else
                local test=game:GetService("StudioTestService")
                if test:CanLeaveTest() then test:LeaveTest() end
            end
        end
    end)
    overlay:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() layout(overlay) end)
    Input:GetPropertyChangedSignal("PreferredInput"):Connect(focus)
    island:GetAttributeChangedSignal("Phase"):Connect(refresh)
    log:GetPropertyChangedSignal("Visible"):Connect(refresh)
    task.defer(require(hud.StoryArt),page.Seascape)
    refresh()
end
]]></ProtectedString>
					<string name="ScriptGuid">{8A2EDA42-89D1-410D-85D4-0BB5BE11BF3F}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Ending</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd000022f9</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="2053">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local user = Players.LocalPlayer
local holder = script.Parent:WaitForChild("Log")
holder.Visible = false
local input=game:GetService("UserInputService")
local function placeLog()
    holder.Position=UDim2.new(.5,0,1,if input.PreferredInput==Enum.PreferredInput.Touch then -82 else -14)
end
placeLog()
input:GetPropertyChangedSignal("PreferredInput"):Connect(placeLog)
local island = workspace:WaitForChild("FireflyIsland")
local tower = island:WaitForChild("Lighthouse")
local boat = island:WaitForChild("FishingBoat"):WaitForChild("Hull")
require(script.Parent:WaitForChild("KoreanLabels"))(script.Parent,island)
local inOpening = require(script.Parent:WaitForChild("Opening"))(script.Parent,boat)
require(script.Parent:WaitForChild("Ending"))(script.Parent,island,inOpening)
local jar = ReplicatedStorage:WaitForChild("KeeperJar"):Clone()
jar.Name = "MyLantern"
local sparks = {jar.Spark1,jar.Spark2,jar.Spark3}
local sites = {}
for _, spot in island:WaitForChild("FireflySpots"):GetChildren() do
    local core=spot:WaitForChild("Firefly")
    local left,right=spot:WaitForChild("LeftWing"),spot:WaitForChild("RightWing")
    table.insert(sites,{spot=spot,core=core,left=left,right=right,
        origin=core.CFrame,leftOrigin=left.CFrame,rightOrigin=right.CFrame,
        phase=tonumber(string.match(spot.Name,"%d+"))*1.77})
end
local cinematic = false
local function refresh()
    local count = island:GetAttribute("Count") or 0
    local phase = island:GetAttribute("Phase") or "Search"
    holder.Count.Text = tostring(count).." / 3"
    local remaining = {}
    for _, entry in sites do
        local available=entry.spot:GetAttribute("Available")==true
        entry.core.Halo.Enabled=available
        entry.core.Drift.Enabled=available
        if available then
            table.insert(remaining, entry.spot:GetAttribute("Landmark"))
        else
            entry.core.Drift:Clear()
        end
    end
    table.sort(remaining)
    if phase == "Search" then
        holder.Objective.Text = if count==0 then "풀숲에 반짝이는 불빛이 보여요. 가까이 가 볼까요?" else "아직 빛이 보여요. "..table.concat(remaining," · ")
    elseif phase == "Climb" then
        holder.Objective.Text = "세 마리를 모았어요! 등대 바깥 계단을 올라 유리병을 걸어 주세요."
    elseif phase == "Sailing" then
        holder.Objective.Text = "등대에 불이 켜졌어요. 어선이 불빛을 따라 돌아옵니다."
    else
        holder.Objective.Text = "어선이 선착장에 닿았어요."
    end
    for i, spark in sparks do spark.Transparency = if i<=count then 0 else 1 end
    jar.Glass.Glow.Brightness = .18 + count*.75
    if phase ~= "Sailing" and phase ~= "Home" and cinematic then
        cinematic=false
        local camera=workspace.CurrentCamera
        if camera then
            camera.CameraType=Enum.CameraType.Custom
            local hum=user.Character and user.Character:FindFirstChildOfClass("Humanoid")
            if hum then camera.CameraSubject=hum end
        end
    end
end
for _, entry in sites do entry.spot:GetAttributeChangedSignal("Available"):Connect(refresh) end
island:GetAttributeChangedSignal("Count"):Connect(refresh)
island:GetAttributeChangedSignal("Phase"):Connect(refresh)
refresh()
local lastHand
RunService.RenderStepped:Connect(function()
    local t=workspace:GetServerTimeNow()
    local phase=island:GetAttribute("Phase")
    local char=user.Character
    local hand=char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
    if hand and (phase=="Search" or phase=="Climb") then
        if hand ~= lastHand or not jar.Parent then jar.Parent=workspace; lastHand=hand end
        jar:PivotTo(hand.CFrame*CFrame.new(0,-hand.Size.Y*.45,-.35)*CFrame.Angles(0,0,.10*math.sin(t*2.6)))
    elseif jar.Parent then jar.Parent=nil; lastHand=nil end
    for _, e in sites do
        local active=e.spot:GetAttribute("Available")==true
        local beat=(1+math.cos(t*2.6+e.phase))*.5
        local fade=if active then .04+.67*beat^2 else 1
        e.core.Transparency=fade
        e.left.Transparency=math.min(1,fade+.1)
        e.right.Transparency=e.left.Transparency
        e.core.Glow.Brightness=if active then .40+(1-fade)*1.75 else 0
        if active then
            e.core.Halo.SoftLight.ImageTransparency=.30+beat*.39
            local offset=Vector3.new(.45*math.sin(t*1.2+e.phase),.32*math.sin(t*2+e.phase),.21*math.cos(t+e.phase))
            e.core.CFrame=e.origin+offset
            e.left.CFrame=(e.leftOrigin+offset)*CFrame.Angles(0,0,math.sin(t*13)*.30)
            e.right.CFrame=(e.rightOrigin+offset)*CFrame.Angles(0,0,-math.sin(t*13)*.30)
        end
    end
    if phase=="Sailing" and not inOpening() and workspace.CurrentCamera then
        local camera=workspace.CurrentCamera
        cinematic=true
        camera.CameraType=Enum.CameraType.Scriptable
        camera.CFrame=CFrame.lookAt(Vector3.new(29,24,-27),boat.Position:Lerp(tower.Lens.Position,.18))
    end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
