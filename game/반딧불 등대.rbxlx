			<Item class="LocalScript" referent="RBX338EB83DFE6F45C983A125AD04733BED">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local score = game:GetService("HttpService"):JSONDecode(script.Score.Value)
local bus = Instance.new("SoundGroup")
bus.Name = "HarbourMusic"
bus.Volume = .74
bus.Parent = SoundService

local eq = Instance.new("EqualizerSoundEffect")
eq.HighGain = -8
eq.MidGain = -1.5
eq.LowGain = 1
eq.Parent = bus
local echo = Instance.new("EchoSoundEffect")
echo.Delay = .315
echo.Feedback = .2
echo.WetLevel = -16
echo.Parent = bus
local room = Instance.new("ReverbSoundEffect")
room.DecayTime = 2.35
room.Density = .68
room.Diffusion = .8
room.WetLevel = -11
room.Parent = bus

local voices = {}
for i = 1, 16 do
    local sound = Instance.new("Sound")
    sound.Name = "Key"..i
    sound.SoundId = "rbxasset://sounds/volume_slider.ogg"
    sound.SoundGroup = bus
    sound.Parent = bus
    table.insert(voices, sound)
end

local notes = {}
local function note(bar, beat, pitch, level)
    table.insert(notes, {time = ((bar-1)*6+beat)*score.eighth, pitch = pitch, level = level})
end
for i, bar in score.bars do
    local chord, melody = bar[1], bar[2]
    note(i, 0, chord[1], .63)
    note(i, 1.58, chord[2], .33)
    note(i, 3.08, chord[3], .38)
    if i%4 ~= 0 then note(i, 4.61, chord[2], .29) end
    for j, item in melody do note(i, item[1], item[2], if j==1 then .82 else .69) end
end
table.sort(notes, function(a,b) return a.time < b.time end)
local loopLength = #score.bars*6*score.eighth
local cursor, voice = 1, 0
local active = true
local heartbeat
script.Destroying:Connect(function()
    active = false
    if heartbeat then heartbeat:Disconnect() end
    bus:Destroy()
end)
pcall(function() ContentProvider:PreloadAsync({voices[1]}) end)
if not active then return end
local started = time()
heartbeat = RunService.Heartbeat:Connect(function()
    local t = time()-started
    if t >= loopLength then
        started += math.floor(t/loopLength)*loopLength
        t = time()-started
        cursor = 1
    end
    while cursor <= #notes and notes[cursor].time <= t do
        local key = notes[cursor]
        if t-key.time < .2 then
            voice = voice % #voices+1
            local sound = voices[voice]
            sound.PlaybackSpeed = 2^((key.pitch-score.samplePitch)/12)
            sound.Volume = key.level
            sound:Play()
        end
        cursor += 1
    end
end)
]]></ProtectedString>
