	<Item class="ServerScriptService" referent="2054">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd00001acd</UniqueId>
		</Properties>
		<Item class="ModuleScript" referent="2055">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local Round = {}
Round.__index = Round

function Round.new(activeSpots)
    local self = setmetatable({ phase = "Search", count = 0, remaining = {} }, Round)
    for _, key in activeSpots do self.remaining[key] = true end
    return self
end

function Round:catch(key)
    if self.phase ~= "Search" or not self.remaining[key] then return false end
    self.remaining[key] = nil
    self.count += 1
    if self.count == 3 then self.phase = "Climb" end
    return true
end

function Round:hang()
    if self.phase ~= "Climb" then return false end
    self.phase = "Sailing"
    return true
end

function Round:arrive()
    if self.phase ~= "Sailing" then return false end
    self.phase = "Home"
    return true
end

return Round
]]></ProtectedString>
				<string name="ScriptGuid">{188537E4-6484-4C7F-B21B-3D3306C86931}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Round</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2e7a9273517799c40b0d71bd00002303</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="2056">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Round = require(script.Parent.Round)

local island = workspace.FireflyIsland
local tower = island.Lighthouse
local boat = island.FishingBoat
local boatStart = boat:GetPivot()
local mooring = CFrame.new(-1, boatStart.Position.Y, -63)
local sites = island.FireflySpots:GetChildren()
local spawn = workspace.HarbourArrival
local sea = workspace.Terrain
sea.WaterColor = Color3.fromRGB(38,78,106)
sea.WaterTransparency = .22
sea.WaterReflectance = .46
sea.WaterWaveSize = .15
sea.WaterWaveSpeed = 6
sea:FillBlock(CFrame.new(0,-8,0),Vector3.new(600,8,600),Enum.Material.Water)
local random = Random.new()
local round
local hangingJar

local function sync()
    island:SetAttribute("Count", round.count)
    island:SetAttribute("Phase", round.phase)
    tower.JarHook.Hang.Enabled = round.phase == "Climb"
    tower.JarHook.Again.Enabled = round.phase == "Home"
end

local function isNear(player, part)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return root and humanoid and humanoid.Health > 0 and (root.Position - part.Position).Magnitude <= 10
end

local function reset()
    local candidates = table.clone(sites)
    local chosen = {"Spot1"} -- An approachable first glimmer close to spawn.
    for i = #candidates, 2, -1 do
        local j = random:NextInteger(1, i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end
    for _, spot in candidates do
        if spot.Name ~= "Spot1" and #chosen < 3 then table.insert(chosen, spot.Name) end
    end
    round = Round.new(chosen)
    if hangingJar then hangingJar:Destroy(); hangingJar = nil end
    boat:PivotTo(boatStart)
    tower.Lens.Material = Enum.Material.Glass
    tower.Lens.Color = Color3.fromRGB(100,139,144)
    tower.Lens.Glow.Brightness = 0
    tower.Lens.GuidingLight.Enabled = false
    tower.BeamTarget.Position = Vector3.new(boatStart.Position.X, -1, boatStart.Position.Z)
    for _, spot in sites do
        local active = round.remaining[spot.Name] == true
        spot:SetAttribute("Available", active)
        spot.Firefly.Catch.Enabled = active
    end
    sync()
end

for _, spot in sites do
    spot.Firefly.Catch.Triggered:Connect(function(player)
        if not isNear(player, spot.Firefly) or not round:catch(spot.Name) then return end
        spot:SetAttribute("Available", false)
        spot.Firefly.Catch.Enabled = false
        sync()
    end)
end

tower.JarHook.Hang.Triggered:Connect(function(player)
    if not isNear(player,tower.JarHook) or not round:hang() then return end
    hangingJar = ReplicatedStorage.KeeperJar:Clone()
    hangingJar.Name = "HangingJar"
    hangingJar:PivotTo(CFrame.new(16, 19.57, -13.23))
    for i=1,3 do hangingJar["Spark"..i].Transparency = 0 end
    hangingJar.Glass.Glow.Brightness = 2
    hangingJar.Parent = tower
    tower.Lens.Material = Enum.Material.Neon
    tower.Lens.Color = Color3.fromRGB(255,223,128)
    tower.Lens.Glow.Brightness = 4
    tower.Lens.GuidingLight.Enabled = true
    sync()
    local started = workspace:GetServerTimeNow()
    local elapsed = 0
    while elapsed < 7 do
        RunService.Heartbeat:Wait()
        elapsed = workspace:GetServerTimeNow() - started
        local u = math.clamp(elapsed / 7, 0, 1)
        local t = u*u*(3-2*u)
        local pose = boatStart:Lerp(mooring, t) * CFrame.new(0, math.sin(u*math.pi*8)*.16*math.sin(math.pi*u),0)
        boat:PivotTo(pose)
        tower.BeamTarget.Position = pose.Position + Vector3.new(0,2,0)
    end
    task.wait(1.5)
    round:arrive()
    sync()
end)

local function returnToShore(character, offset)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        character:PivotTo(spawn.CFrame * CFrame.new(offset or 0,3.8,0))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function replay()
    if round.phase ~= "Home" then return end
    reset()
    for i, p in Players:GetPlayers() do returnToShore(p.Character, (i-1)%4*2) end
end
tower.JarHook.Again.Triggered:Connect(function(player)
    if isNear(player,tower.JarHook) then replay() end
end)
ReplicatedStorage.PlayAgain.OnServerEvent:Connect(replay)
ReplicatedStorage.FinishStudioPlay.OnServerEvent:Connect(function()
    if RunService:IsStudio() and round.phase=="Home" and #Players:GetPlayers()==1 then
        game:GetService("StudioTestService"):EndTest("Home")
    end
end)
reset()
-- Falling in the water returns the keeper to land without losing the collected light.
task.spawn(function()
    while true do
        task.wait(.35)
        for _, p in Players:GetPlayers() do
            local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Position.Y < -6 then returnToShore(p.Character) end
        end
    end
end)
]]></ProtectedString>
